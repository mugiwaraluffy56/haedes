# Public control-plane configuration (never commit real values).
HAEDES_ENV=development
HAEDES_LOG_LEVEL=info
HAEDES_AWS_REGION=us-east-1
HAEDES_API_BASE_URL=http://localhost:8080

# Local development only. Production credentials come from the AWS runtime.
HAEDES_API_KEY=replace-me
# Production requires a secret with at least 32 bytes. Never commit a real value.
HAEDES_SIGNING_SECRET=replace-with-at-least-32-random-bytes
